{
  "name": "help-and-tips-feature",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/help-and-tips/feature/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:feature"],
  "targets": {
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/help-and-tips/feature"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/help-and-tips/feature"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/scripts/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
